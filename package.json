{
  "name": "detour-proxy",
  "version": "1.0.0",
  "description": "Detour Proxy — a Manifest V3 browser extension (Chrome/Edge) that detours browser traffic through your LAN v2raya proxy endpoint.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "icons": "node scripts/icons.mjs",
    "promo": "node scripts/promo.mjs",
    "package": "tsc -p tsconfig.json && node scripts/icons.mjs && node scripts/package.mjs",
    "zip": "npm run package && node scripts/zip.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@types/chrome": "^0.0.270",
    "@types/node": "^20.14.0",
    "adm-zip": "^0.5.18",
    "fast-check": "^3.19.0",
    "jsdom": "^24.1.0",
    "sharp": "^0.35.2",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
